# Configure valores únicos y seguros antes de ejecutar Docker Compose.
APP_PORT=3000
MYSQL_DATABASE=tv_personalizado
MYSQL_USER=tv_app
MYSQL_PASSWORD=REEMPLAZAR_CON_SECRETO_HEXADECIMAL
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRO_SECRETO_HEXADECIMAL

# Credenciales Manus OAuth. No las compartas ni las guardes en Git.
# Deben corresponder al proyecto y a un callback HTTPS permitido por Manus.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
